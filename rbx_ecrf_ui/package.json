  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@sap/cds": "^10",
    "express": "^5"
  },
  "devDependencies": {
    "@cap-js/cds-types": "^0.20.0",
    "@cap-js/sqlite": "^3",
    "fs-extra": "^11.4.1",
    "mbt": "^1.2.49",
    "minimist": "^1.2.8",
    "request": "^2.88.2",
    "request-promise-native": "^1.0.9"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "dev": "node dev-server.js",
    "build:ui": "npm run build:cf --prefix uimodule",
    "build": "mbt build -p=cf -t mta_archives --mtar rbx-ecrf.mtar",
    "deploy": "cf deploy mta_archives/rbx-ecrf.mtar -f",
    "build:deploy": "npm run build && npm run deploy",
    "logs": "cf logs rbx-ecrf-ui",
    "logs:recent": "cf logs rbx-ecrf-ui --recent"
  },
  "allowScripts": {
    "mbt@1.2.49": true
  }
