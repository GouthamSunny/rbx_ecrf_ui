{
    "_version": "1.60.0",
    "sap.app": {
        "id": "rbx.ecrf.uimodule",
        "type": "application",
        "i18n": "i18n/i18n.properties",
        "applicationVersion": {
            "version": "1.0.0"
        },
        "title": "{{appTitle}}",
        "description": "{{appDescription}}",
        "dataSources": {
            "appConfig": {
                "uri": "appconfig",
                "type": "JSON"
            },
            "servers": {
                "uri": "model/servers.json",
                "type": "JSON"
            },
            "forms": {
                "uri": "model/forms.json",
                "type": "JSON"
            }
        }
    },
    "sap.ui": {
        "technology": "UI5",
        "deviceTypes": {
            "desktop": true,
            "tablet": true,
            "phone": true
        }
    },
    "sap.ui5": {
        "rootView": {
            "viewName": "rbx.ecrf.uimodule.view.App",
            "type": "XML",
            "id": "App"
        },
        "dependencies": {
            "minUI5Version": "1.120.0",
            "libs": {
                "sap.ui.core": {},
                "sap.m": {},
                "sap.f": {}
            }
        },
        "contentDensities": {
            "compact": true,
            "cozy": true
        },
        "models": {
            "i18n": {
                "type": "sap.ui.model.resource.ResourceModel",
                "settings": {
                    "bundleName": "rbx.ecrf.uimodule.i18n.i18n"
                }
            },
            "": {
                "type": "sap.ui.model.json.JSONModel",
                "dataSource": "appConfig"
            },
            "servers": {
                "type": "sap.ui.model.json.JSONModel",
                "dataSource": "servers"
            },
            "forms": {
                "type": "sap.ui.model.json.JSONModel",
                "dataSource": "forms"
            }
        },
        "resources": {
            "css": [
                {
                    "uri": "css/style.css"
                }
            ]
        },
        "routing": {
            "config": {
                "routerClass": "sap.m.routing.Router",
                "type": "View",
                "viewType": "XML",
                "path": "rbx.ecrf.uimodule.view",
                "controlId": "app",
                "controlAggregation": "pages",
                "async": true
            },
            "routes": [
                {
                    "name": "main",
                    "pattern": "",
                    "target": "main"
                }
            ],
            "targets": {
                "main": {
                    "id": "main",
                    "name": "Main"
                }
            }
        }
    }
}
